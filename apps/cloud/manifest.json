{
  "name": "cloud",
  "label": "云盘",
  "icon": "/resources/public/icons/Files.png",
  "color": "#5856D6",
  "category": "utility",
  "order": 99,
  "defaultEnabled": true,
  "canDisable": true,
  "frontend": {
    "route": "/cloud",
    "routeName": "CloudDrive",
    "component": "./frontend/CloudDrive.vue",
    "extraRoutes": [
      { "path": "/cloud-picker", "routeName": "CloudFilePicker", "component": "./frontend/CloudFilePicker.vue" },
      { "path": "/cloud-upload", "routeName": "CloudUpload", "component": "./frontend/CloudUpload.vue" },
      { "path": "/guest-upload", "routeName": "GuestUpload", "component": "./frontend/GuestUpload.vue", "requiresAuth": false, "appControl": false }
    ]
  },
  "backend": {
    "mountPath": "/api/cloud",
    "entry": "./backend/routes.js"
  }
}
