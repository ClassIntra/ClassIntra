{
  "name": "weather",
  "type": "app",
  "version": "1.0.0",
  "label": "天气",
  "icon": "/resources/public/icons/Weather.png",
  "color": "#5AC8FA",
  "category": "desktop",
  "order": 6,
  "defaultEnabled": true,
  "canDisable": true,
  "frontend": {
    "route": "/weather",
    "routeName": "Weather",
    "component": "./frontend/Weather.vue",
    "widgets": [
      {
        "id": "weather-now",
        "name": "实时天气",
        "component": "./frontend/widgets/WeatherNowWidget.vue",
        "defaultSize": {
          "w": 2,
          "h": 2
        },
        "minSize": {
          "w": 2,
          "h": 2
        },
        "maxSize": {
          "w": 4,
          "h": 2
        },
        "description": "当前天气与温度",
        "widenable": true,
        "configSchema": {
          "fields": [
            {
              "key": "city",
              "label": "城市名",
              "type": "text",
              "default": "庐江"
            }
          ]
        }
      }
    ]
  },
  "backend": {
    "mountPath": "/api/weather",
    "entry": "./backend/routes.js"
  }
}
