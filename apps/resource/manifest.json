{
  "name": "resource",
  "type": "app",
  "version": "1.0.0",
  "label": "资源",
  "icon": "/resources/public/icons/Files.png",
  "color": "#5856D6",
  "category": "desktop",
  "order": 5,
  "defaultEnabled": true,
  "canDisable": true,
  "frontend": {
    "route": "/resource",
    "routeName": "Resource",
    "component": "./frontend/Resource.vue",
    "extraRoutes": [
      { "path": "/cloud", "routeName": "CloudDrive", "component": "./frontend/CloudDrive.vue" },
      { "path": "/cloud-picker", "routeName": "CloudFilePicker", "component": "./frontend/CloudFilePicker.vue" },
      { "path": "/cloud-upload", "routeName": "CloudUpload", "component": "./frontend/CloudUpload.vue" },
      { "path": "/guest-upload", "routeName": "GuestUpload", "component": "./frontend/GuestUpload.vue", "requiresAuth": false, "appControl": false }
    ]
  },
  "backend": {
    "mountPath": "/api/resources",
    "entry": "./backend/routes.js"
  },
  "extraBackends": [
    { "mountPath": "/api/cloud", "entry": "./backend/cloud-routes.js" }
  ]
}
