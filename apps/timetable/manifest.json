{
  "name": "timetable",
  "label": "课程表",
  "icon": "/resources/public/icons/Timetable.png",
  "color": "#FF3B30",
  "category": "desktop",
  "order": 9,
  "defaultEnabled": true,
  "canDisable": true,
  "frontend": {
    "route": "/timetable",
