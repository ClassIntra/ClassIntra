        "maxSize": { "w": 4, "h": 4 },
        "description": "显示今日课程和下节课倒计时",
        "configSchema": null
      }
    ]
  },
  "backend": {
    "mountPath": "/api/timetable",
    "entry": "./backend/routes.js"
  }
}
