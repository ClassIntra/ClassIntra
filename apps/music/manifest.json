{
  "name": "music",
  "type": "app",
  "version": "1.0.0",
  "label": "音乐",
  "icon": "/resources/public/icons/Music.png",
  "color": "#FF2D55",
  "category": "desktop",
  "order": 7,
  "defaultEnabled": true,
  "canDisable": true,
  "frontend": {
    "route": "/music",
    "routeName": "Music",
    "component": "./frontend/Music.vue",
    "meta": {
      "requiresAuth": false
    },
    "widgets": [
      {
        "id": "music-mini",
        "name": "音乐播控",
        "component": "./frontend/widgets/MusicMiniWidget.vue",
        "defaultSize": {
          "w": 2,
          "h": 2
        },
        "minSize": {
          "w": 2,
          "h": 2
        },
        "maxSize": {
          "w": 4,
          "h": 2
        },
        "description": "正在播放与快捷控制",
        "widenable": true
      }
    ]
  },
  "backend": {
    "mountPath": "/api/music",
    "entry": "./backend/routes.js"
  }
}
