# ============================================================
# ClassIntra 服务端配置模板
# 用法：复制本文件为 server/.env 后按需填写。
# 含真实密钥的 .env 及其变体（.env.*）已被 .gitignore 忽略，勿入库。
# 标注「可选」的项留空即使用代码内默认值。
# ============================================================

# ---- 服务端口 ----
PORT=9001
WS_PORT=10001
# 浏览器探测独立服务端口（browser-detect）
DETECT_PORT=7998

# ---- HTTPS / 隧道网关（受限网络下的入口，可选）----
# HTTPS 控制 secure cookie
HTTPS=false
# HTTPS_ENABLED=true 时聊天 WS 走 wss
HTTPS_ENABLED=false
HTTPS_PORT=9001
# 隧道网关：对外入口端口，以及转发到的本机上游端口
TUNNEL_GATEWAY_PORT=9002
UPSTREAM_PORT=9001

# ---- JWT 配置（必须设置，否则服务无法启动）----
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ---- 班管ID（逗号分隔，格式 YYCC00，末两位为00，中间两位为班级号）----
# 例如 250100 表示25届01班班管。支持多个班级：250100,250200
# 班管不预创建账号，真实用户通过预注册名单注册后自动获得管理员权限
# 请确保预注册名单 (config/pre-records.json) 中包含对应 user_id 的用户
ADMIN_USER_IDS=250100

# ---- 开发者账号密码（可选，设置后创建 ID=999999 的开发者账号用于测试）----
# DEV_PASSWORD=dev123456

# ---- 机器人管理员白名单（逗号分隔，user_id）----
# 命中者的 is_admin 会被置为 1，且在「跨班用户操作 / PM2 控制」等处豁免按班级的权限比对
# （机器人账号通常不是 YYCCxx 形式，无法参与班级比对，故需在此登记）
# 仅用于自动化账号；人类管理员请用上面的 ADMIN_USER_IDS
BOT_ADMIN_IDS=

# ============================================================
# AstrBot 接入（astrbot-relay 插件用；配置说明见 plugins/astrbot-relay/backend/relay.js）
# ============================================================

# ---- 机器人账号 ----
# BOT_USER_ID 机器人账号 user_id；BOT_PASSWORD 必填（建号与 WS 登录共用）
# ASTRBOT_PUBLISH_KEY AstrBot 侧调用 /api/astrbot/* 的共享密钥
BOT_USER_ID=
BOT_PASSWORD=
BOT_NET_NAME=
BOT_REAL_NAME=
BOT_GENDER=
ASTRBOT_PUBLISH_KEY=

# ---- 反向 WS（aiocqhttp）----
# ASTRBOT_WS_URL AstrBot aiocqhttp 反向 WS 地址
ASTRBOT_WS_URL=ws://127.0.0.1:6199/ws
# ASTRBOT_WS_TOKEN 反向 WS 访问令牌
ASTRBOT_WS_TOKEN=
# ASTRBOT_OWNER_IDS 可指挥机器人的授权人（逗号分隔 user_id）；留空回退 ADMIN_USER_IDS
ASTRBOT_OWNER_IDS=
# ASTRBOT_PACK_MEMES_DIR 表情包兜底映射源：meme_manager 表情分类目录的绝对路径
ASTRBOT_PACK_MEMES_DIR=

# ---- 直连快通道 ----
# OneBot 断开时经隧道直调 AstrBot /api/chat 完整管线（同步模式），回复由本机 CI 直接发出
AB_DIRECT_API_URL=http://127.0.0.1:6200/api/chat
AB_DIRECT_TOKEN=
AB_DIRECT_TIMEOUT=150000
# AB_ONEBOT_DISABLED 置 1 则禁用 OneBot 通道，只走直连
AB_ONEBOT_DISABLED=
# AB_ALLOWED_USERS 用户白名单（逗号分隔）；空=所有人
AB_ALLOWED_USERS=
# AB_MAX_SEGMENTS 单次回复最多分段数
AB_MAX_SEGMENTS=3

# ---- 媒体落盘与跨机回源 ----
# AB_RESOURCE_DIR 媒体落盘目录；留空为 <工作目录>/Resources/cloud/botmedia
AB_RESOURCE_DIR=
# AB_RESOURCE_URL_BASE 站内媒体 URL 前缀（对应上面的落盘目录静态挂载点）
AB_RESOURCE_URL_BASE=/resources/cloud/botmedia/remote/
# AB_MAX_DOWNLOAD_MB 单文件下载上限（MB）
AB_MAX_DOWNLOAD_MB=200
# AB_PEER_STATIC_BASE 跨机媒体回源地址（逗号分隔，可多个）；留空则由 RELAY_SERVERS 自动推导
AB_PEER_STATIC_BASE=

# ---- 和风天气 API 配置 ----
QWEATHER_KEY=your-qweather-api-key
QWEATHER_LOCATION=116.41,39.92
QWEATHER_API_HOST=devapi.qweather.com
QWEATHER_KID=
QWEATHER_SUB=
QWEATHER_PRIVATE_KEY=

# ---- AI 聊天 · 内置默认模型 ----
# 模型注册表种子行 default 的兜底配置。v1.3 起 AI 模型由 ai_models 表驱动
# （AI 应用内「模型管理」面板可增删任意 OpenAI 兼容模型），此处仅作兜底值。
AI_API_KEY=your-ai-api-key
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-3.5-turbo
# 可用子模型列表（历史遗留；新版由模型注册表管理，此变量仅作初始化参考）
AI_AVAILABLE_MODELS=gpt-4o-mini-2024-07-18,gpt-4o-mini

# ---- AI 聊天 · DeepSeek 模型 ----
# 模型注册表种子行 deepseek 的兜底配置，同样可被管理面板的 DB 值覆盖。
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ---- Tavily 搜索 API ----
# AI 联网搜索的上游；勾选了「联网搜索」能力的模型都会用到。
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search

# ---- 资源目录和数据库路径 ----
RESOURCES_DIR=../Resources
DB_PATH=./database/classintra.db
# 市场仓本地路径（market-service 读取应用/插件目录）；留空为 主仓同级的 market/
MARKET_LOCAL_DIR=

# ---- 中继服务器配置（多实例部署时使用）----
RELAY_SERVERS=
RELAY_SECRET=
RELAY_SERVER_ID=class-a
RELAY_PORT=10011
# CC 班级联动批次标识（届数，逗号分隔），只有同届班级间才中继消息
# 为空时自动从 ADMIN_USER_IDS 推断
COHORT=25

# ---- CORS 跨域配置 ----
CORS_ORIGINS=

# ---- Syncthing 文件同步配置 ----
SYNCTHING_HOST=localhost
SYNCTHING_PORT=8384
SYNCTHING_API_KEY=

# ---- Tailscale VPN 配置 ----
TAILSCALE_ENABLED=false
TAILSCALE_RELAY_IP=
TAILSCALE_STATUS_CMD=tailscale status --json

# ---- 开发 / 运维开关 ----
# 详细日志（设为 1 启用活动日志记录）
VERBOSE_LOG=0
# 服务端热重载（开发用，设为 1 启用）
CLASSINTRA_HOT_RELOAD=0
# 锁屏页脚的 WIFI 名：默认由服务端跑 netsh 读本机当前关联的无线网。
# 若服务器走有线网 / 跑在虚拟机 / 探测结果不正确，可在此手动指定，锁定显示值。
LOCK_INFO_WIFI=
# GitHub Token（仅 scripts/release.js 发版用；切勿把真实 token 写进模板或提交）
GH_TOKEN=
