{
  "name": "classintra",
  "version": "1.2.2",
  "private": true,
  "license": "MIT",
  "author": "ClassIntra",
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter client run dev",
    "dev:server": "pnpm --filter server run dev",
    "dev:client": "pnpm --filter client run dev",
    "build": "cd client && pnpm run build",
    "start": "pnpm --filter server run start",
    "version": "node scripts/version.js",
    "version:show": "node scripts/version.js show",
    "version:check": "node scripts/version.js check",
    "verify:modules": "node scripts/modularity-verify.js --mode all",
    "verify:modules:plugins": "node scripts/modularity-verify.js --mode plugins",
    "verify:modules:apps": "node scripts/modularity-verify.js --mode modules",
    "verify:motion": "node scripts/motion-verify.js",
    "verify:schema": "node scripts/schema-verify.mjs",
    "verify:all": "pnpm verify:modules && pnpm verify:motion && pnpm verify:schema",
    "review:market": "node scripts/market-review.mjs",
    "create:app": "node scripts/create-app.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.2"
  }
}
